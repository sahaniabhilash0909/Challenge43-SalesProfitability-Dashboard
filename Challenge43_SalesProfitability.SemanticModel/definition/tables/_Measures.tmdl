	measure 'Evidence Discount' = VAR ns = [Deep Net Sales AC] RETURN IF ( ISBLANK ( ns ), "No 20%+ discount sales in this selection", FORMAT ( ns / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " of net sales went out at 20%+ discount and earned " & FORMAT ( [Deep Margin AC], "0.0%;−0.0%" ) & "; the 10–19% band earned " & FORMAT ( CALCULATE ( [Contribution Margin %], KEEPFILTERS ( FactSales[DiscountBandSort] = 2 ), 'Scope'[Scope] = "AC" ), "0.0%;−0.0%" ) & ". Black Friday sits in this group." )
		displayFolder: 15 Redesign\Story\Actions
		lineageTag: 73587954-29eb-4177-b41f-4c1294326eaf

	measure 'Evidence OE' = VAR ns = [OE Net Sales AC] RETURN IF ( ISBLANK ( ns ), "No online electronics sales in this selection", "Online electronics sold " & FORMAT ( ns / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " at a " & FORMAT ( [OE Margin AC], "0.0%;−0.0%" ) & " margin; the same products earn " & FORMAT ( [IE Margin AC], "0.0%;−0.0%" ) & " in-store. Closing half that gap with bundles and accessory attach instead of price cuts." )
		displayFolder: 15 Redesign\Story\Actions
		lineageTag: 3ca850b0-c754-47c5-b91e-bc0f6f44c8c6

	measure 'Evidence Returns' = VAR ra = [Apparel Return Rate AC] RETURN IF ( ISBLANK ( ra ), "No apparel sales in this selection", "Apparel returns " & FORMAT ( ra, "0.0%" ) & " of units vs " & FORMAT ( CALCULATE ( [Return Rate %], 'Scope'[Scope] = "AC" ), "0.0%" ) & " across the store, costing " & FORMAT ( [Apparel Return Cost AC] / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " in refunds and handling. Bringing it to the store average (size guides, fit notes) is the move." )
		displayFolder: 15 Redesign\Story\Actions
		lineageTag: 50d0d582-e7f2-4f6e-81be-14a2c7114b8a

	measure 'Evidence NY' = VAR mn = CALCULATE ( [Contribution Margin %], KEEPFILTERS ( DimCampaign[Campaign Type] = "New Year" ), 'Scope'[Scope] = "AC" ) VAR mx = CALCULATE ( [Contribution Margin %], KEEPFILTERS ( DimCampaign[Campaign Type] = "Christmas" ), 'Scope'[Scope] = "AC" ) RETURN IF ( ISBLANK ( mn ) || ISBLANK ( mx ), "New Year or Christmas not in this selection", "New Year earned a " & FORMAT ( mn, "0.0%;−0.0%" ) & " margin while Christmas kept " & FORMAT ( mx, "0.0%;−0.0%" ) & " with shallow, gift-led offers. Lifting New Year to half the Christmas margin (clearance of aged stock only)." )
		displayFolder: 15 Redesign\Story\Actions
		lineageTag: 77d03587-f4f0-4f1e-9078-33439a74daac

	measure 'Msg Ch1' =
			VAR a = [Contribution AC] VAR p = [Contribution PY] VAR g = DIVIDE ( [Gross Sales AC] - [Gross Sales PY], [Gross Sales PY] )
			VAR ma = [Margin AC] VAR mp = [Margin PY]
			VAR why = SWITCH ( TRUE (),
			    a >= p && g <= 0, ": a margin story, not a volume story",
			    a >= p && ma >= mp, ": both volume and margin helped",
			    a >= p, ": volume carried it while margin slipped",
			    g > 0, ": more sales but thinner margins",
			    ": less volume and thinner margins" )
			RETURN IF ( ISBLANK ( p ),
			    "Contribution profit was " & FORMAT ( a / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " in " & [AC Season] & " at a " & FORMAT ( ma, "0.0%" ) & " margin (no previous season to compare)",
			    "Contribution profit " & IF ( a >= p, "rose ", "fell " ) & FORMAT ( ABS ( a - p ) / 1000, "\€#,0.0\k" ) & " (" & FORMAT ( DIVIDE ( a - p, ABS ( p ) ), "+0%;−0%" ) & ") on " & FORMAT ( g, "+0%;−0%" ) & " gross sales" & why & " (margin " & FORMAT ( mp, "0.0%;−0.0%" ) & " → " & FORMAT ( ma, "0.0%;−0.0%" ) & ")" )
		displayFolder: 15 Redesign\Story\Messages
		lineageTag: ca2d0467-a5df-4e5a-889f-ba6948b700f4

	measure 'Msg Ch2' = VAR na = [Deep Net Sales AC] VAR np = [Deep Net Sales PY] VAR ca = [Deep Contribution AC] VAR cp = [Deep Contribution PY] RETURN IF ( ISBLANK ( np ) || ISBLANK ( na ), "Deep discounts (20%+): " & FORMAT ( na / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " of net sales earning " & FORMAT ( ca / 1000, "\€#,0.0\k;−\€#,0.0\k" ), "Fewer deep discounts did it: 20%+ discount sales went " & FORMAT ( np / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " → " & FORMAT ( na / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " and their contribution " & FORMAT ( cp / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " → " & FORMAT ( ca / 1000, "\€#,0.0\k;−\€#,0.0\k" ) )
		displayFolder: 15 Redesign\Story\Messages
		lineageTag: 66f38759-fcba-4368-888f-0b816fca9686

	measure 'Msg Ch3' = VAR ns = [OE Net Sales AC] VAR share = DIVIDE ( ns, [Net Sales AC] ) RETURN IF ( ISBLANK ( ns ), [Title Category AC], "The biggest leak left is online electronics: " & FORMAT ( share, "0%" ) & " of net sales (" & FORMAT ( ns / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & ") at a " & FORMAT ( [OE Margin AC], "0.0%;−0.0%" ) & " margin" )
