	measure 'Bridge Impact k' = VAR l = SELECTEDVALUE ( 'Bridge Lines'[Line] ) VAR a = CALCULATE ( [Bridge Raw], 'Scope'[Scope] = "AC" ) VAR p = CALCULATE ( [Bridge Raw], 'Scope'[Scope] = "PY" ) RETURN IF ( ISBLANK ( a ) || ISBLANK ( p ), BLANK (), IF ( l = "Gross Sales", 1, -1 ) * ( a - p ) / 1000 )
		formatString: +#,0.0;−#,0.0;0.0
		displayFolder: 15 Redesign\Story\Bridge
		lineageTag: 378563fa-e4ce-432e-9e1f-d787d9ed2e58

	measure 'Bridge Cum k' = VAR cur = SELECTEDVALUE ( 'Bridge Lines'[Sort] ) RETURN [Contribution PY k] + SUMX ( FILTER ( ALL ( 'Bridge Lines' ), 'Bridge Lines'[Kind] = "Delta" && 'Bridge Lines'[Sort] < cur ), [Bridge Impact k] )
		displayFolder: 15 Redesign\Story\Bridge
		lineageTag: 02e2d98b-792a-4b5a-8cd7-c2c5ef510eed

	measure 'Bridge Base k' = IF ( SELECTEDVALUE ( 'Bridge Lines'[Kind] ) = "Delta" && NOT ISBLANK ( [Bridge Impact k] ), MIN ( [Bridge Cum k], [Bridge Cum k] + [Bridge Impact k] ) )
