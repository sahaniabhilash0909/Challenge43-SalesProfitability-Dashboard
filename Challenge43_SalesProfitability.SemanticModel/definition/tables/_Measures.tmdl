	measure 'Colour Bridge Step' = SWITCH ( SELECTEDVALUE ( 'Profit Steps'[Step Type] ), "Total", IF ( [Profit Step Value] < 0, "#EF8354", "#4F5D75" ), "Revenue leak", "#EF8354", "Product cost", "#7B89A0", "#B5BECC" )
