		lineageTag: 81ef34c4-89e0-4ea9-9963-489bb6a11d9e

	measure 'Title Subcat AC' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( DimProduct[Subcategory] ), "@n", [Net Sales AC], "@m", [Margin AC] ), NOT ISBLANK ( [@n] ) )
			VAR big = TOPN ( 1, t, [@n], DESC )
			VAR best = TOPN ( 1, t, [@m], DESC )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "No sales in this selection",
			        MAXX ( big, DimProduct[Subcategory] ) & " is the largest subcategory (" & FORMAT ( MAXX ( big, [@n] ) / 1000, "\€#,0.0\k" ) & ") at a " & FORMAT ( MAXX ( big, [@m] ), "0.0%" ) & " margin; " & MAXX ( best, DimProduct[Subcategory] ) & " keeps the most (" & FORMAT ( MAXX ( best, [@m] ), "0.0%" ) & ")" )
		displayFolder: 15 Redesign
		lineageTag: 63439994-9152-461d-9ff6-cf29eae537e7

