	measure 'Title Variance Bridge' =
			VAR d = [Contribution ΔPY]
			VAR steps = ADDCOLUMNS ( FILTER ( VALUES ( 'Profit Steps'[Step] ), 'Profit Steps'[Step] <> "Contribution Profit" ), "@d", [Step ΔPY] )
			VAR topStep = TOPN ( 1, steps, ABS ( [@d] ), DESC )
			VAR nm = MAXX ( topStep, 'Profit Steps'[Step] )
			VAR v = MAXX ( topStep, [@d] )
			RETURN
			    IF ( ISBLANK ( d ), "No previous season to compare with " & [AC Season],
			        "Contribution " & IF ( d >= 0, "rose ", "fell " ) & FORMAT ( ABS ( d ) / 1000, "\€#,0.0\k" ) & " vs PY (" & FORMAT ( [Contribution ΔPY%], "+0%;−0%" ) & ") — biggest driver: " & LOWER ( nm ) & " (" & FORMAT ( v / 1000, "+\€#,0.0\k;−\€#,0.0\k" ) & ")" )
		displayFolder: 14 IBCS text
		lineageTag: e2f1d3c7-f884-4e87-9167-7895fa2bf75f

	measure 'Title Scorecard Var' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( DimCampaign[Campaign Type] ), "@ac", [Contribution AC], "@d", [Contribution ΔPY] ), NOT ISBLANK ( [@ac] ) )
			VAR loss = TOPN ( 1, t, [@ac], ASC )
			VAR up = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@d] ) ), [@d], DESC )
			VAR dn = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@d] ) ), [@d], ASC )
			VAR la = MAXX ( loss, [@ac] )
			VAR ln = MAXX ( loss, DimCampaign[Campaign Type] )
			VAR un = MAXX ( up, DimCampaign[Campaign Type] )
			VAR ud = MAXX ( up, [@d] )
			RETURN
			    SWITCH ( TRUE (),
			        COUNTROWS ( t ) = 0, "No sales in this selection",
			        la < 0 && ln = un && ud > 0, ln & " cut its loss by " & FORMAT ( ud / 1000, "\€#,0.0\k" ) & " vs PY but still loses " & FORMAT ( -la / 1000, "\€#,0.0\k" ),
			        la < 0, ln & " still loses " & FORMAT ( -la / 1000, "\€#,0.0\k" ) & IF ( ISBLANK ( ud ), "", "; biggest gain vs PY: " & un & " (" & FORMAT ( ud / 1000, "+\€#,0.0\k;−\€#,0.0\k" ) & ")" ),
			        ISBLANK ( ud ), "Every campaign type is profitable; " & ln & " earns the least",
			        "Biggest gain vs PY: " & un & " (" & FORMAT ( ud / 1000, "+\€#,0.0\k;−\€#,0.0\k" ) & ")" & IF ( MAXX ( dn, [@d] ) < 0, "; biggest drop: " & MAXX ( dn, DimCampaign[Campaign Type] ) & " (" & FORMAT ( MAXX ( dn, [@d] ) / 1000, "+\€#,0.0\k;−\€#,0.0\k" ) & ")", "" ) )
		displayFolder: 14 IBCS text
		lineageTag: d8c9b50b-2954-4deb-8076-8305b12b19cf

	measure 'Title Drill AC' =
			VAR c = SELECTEDVALUE ( DimCampaign[Campaign] )
			VAR t = SELECTEDVALUE ( DimCampaign[Campaign Type] )
			VAR nm = COALESCE ( c, IF ( NOT ISBLANK ( t ), t & " " & [AC Season] ), "All trading " & [AC Season] )
			RETURN nm & ": " & [KPI Net Sales AC] & " net sales at a " & [KPI Margin AC] & " margin and " & [KPI Discount AC] & " average discount"
		displayFolder: 14 IBCS text
		lineageTag: 59f06f0c-6470-4d7e-963e-8484c1730c6e

	measure 'TT Var Line' = "Net sales " & [KPI Net Sales Δ] & "  ·  margin " & [KPI Margin Δ]
