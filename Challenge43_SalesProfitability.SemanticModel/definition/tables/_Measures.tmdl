	measure 'Title Season Trend' =
			VAR t = ADDCOLUMNS ( SUMMARIZE ( FactSales, DimDate[Season], DimDate[HolidaySeasonSort] ), "@c", [Contribution Profit], "@m", [Contribution Margin %] )
			VAR firstS = TOPN ( 1, t, DimDate[HolidaySeasonSort], ASC )
			VAR lastS = TOPN ( 1, t, DimDate[HolidaySeasonSort], DESC )
			RETURN
			    IF ( COUNTROWS ( t ) < 2, "Contribution by season (select fewer filters to compare seasons)",
			        "Contribution went from " & FORMAT ( MAXX ( firstS, [@c] ) / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " in " & MAXX ( firstS, DimDate[Season] ) & " to " & FORMAT ( MAXX ( lastS, [@c] ) / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " in " & MAXX ( lastS, DimDate[Season] ) & " (margin " & FORMAT ( MAXX ( firstS, [@m] ), "0.0%;−0.0%" ) & " → " & FORMAT ( MAXX ( lastS, [@m] ), "0.0%;−0.0%" ) & ")" )
		displayFolder: 14 IBCS text
		lineageTag: 73468287-9f86-41ba-a9ba-a6e40524f093

