	measure 'Filters Line' =
			VAR f = { ( "Channel", IF ( ISFILTERED ( FactSales[Sales Channel] ), CONCATENATEX ( VALUES ( FactSales[Sales Channel] ), FactSales[Sales Channel], ", " ) ) ),
			    ( "Segment", IF ( ISFILTERED ( FactSales[Customer Segment] ), CONCATENATEX ( VALUES ( FactSales[Customer Segment] ), FactSales[Customer Segment], ", " ) ) ),
			    ( "Market", IF ( ISFILTERED ( DimLocation[City] ), CONCATENATEX ( VALUES ( DimLocation[City] ), DimLocation[City], ", " ) ) ),
			    ( "Category", IF ( ISFILTERED ( DimProduct[Category] ), CONCATENATEX ( VALUES ( DimProduct[Category] ), DimProduct[Category], ", " ) ) ),
			    ( "Campaign", IF ( ISFILTERED ( DimCampaign[Campaign Type] ), CONCATENATEX ( VALUES ( DimCampaign[Campaign Type] ), DimCampaign[Campaign Type], ", " ) ) ),
			    ( "Discount", IF ( ISFILTERED ( FactSales[Discount Band] ), CONCATENATEX ( VALUES ( FactSales[Discount Band] ), FactSales[Discount Band], ", " ) ) ) }
			VAR txt = CONCATENATEX ( FILTER ( f, NOT ISBLANK ( [Value2] ) ), [Value1] & ": " & [Value2], "  ·  " )
			RETURN "Filters  ·  " & IF ( ISBLANK ( txt ) || txt = "", "none (all channels, segments, markets, categories)", txt )
		displayFolder: 15 Redesign
		lineageTag: b313fbba-0970-4fc2-b104-67ff33fa3e09

