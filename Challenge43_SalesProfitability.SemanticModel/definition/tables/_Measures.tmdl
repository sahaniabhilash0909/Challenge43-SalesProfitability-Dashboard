/// All report measures.
table _Measures
	lineageTag: 6e1b4f27-8e1c-4bc6-89dc-6b2d8d8227aa

	/// Units x list price, before discounts and refunds.
	measure 'Gross Sales' = SUM ( FactSales[GrossSalesEUR] )
		formatString: \€#,0
		displayFolder: 1 Revenue
		lineageTag: 9af7d32c-33fc-4d67-84be-53d0e949e2e4

	measure 'Discount Amount' = SUM ( FactSales[DiscountAmountEUR] )
		formatString: \€#,0
		displayFolder: 1 Revenue
		lineageTag: c850d45f-d87a-48ab-b122-42dcc45ad45a

	measure 'Sales After Discount' = SUM ( FactSales[SalesAfterDiscountEUR] )
		formatString: \€#,0
		displayFolder: 1 Revenue
		lineageTag: bf4f38d1-ec0c-4474-903d-c40e9ccca22a

	measure Refunds = SUM ( FactSales[RefundsEUR] )
		formatString: \€#,0
		displayFolder: 1 Revenue
		lineageTag: 6c928915-7d96-4a38-8a27-b481c5f4a04c

	/// Discounted sales less refunds.
	measure 'Net Sales' = SUM ( FactSales[NetSalesEUR] )
		formatString: \€#,0
		displayFolder: 1 Revenue
		lineageTag: 643118bd-6ad3-4d63-8a18-1ea243eb9c6d

	measure 'Gross COGS' = SUM ( FactSales[GrossCOGSEUR] )
		formatString: \€#,0
		displayFolder: 2 Costs
		lineageTag: 6ffaa723-0fa3-4639-90ed-23842c06a527

	measure 'Recovered COGS' = SUM ( FactSales[RecoveredCOGSEUR] )
		formatString: \€#,0
		displayFolder: 2 Costs
		lineageTag: 814fb281-f78b-48f6-ab82-007e4d7d6618

	/// Product cost less recoverable value of returned stock.
	measure 'Net COGS' = SUM ( FactSales[NetCOGSEUR] )
		formatString: \€#,0
		displayFolder: 2 Costs
		lineageTag: 9da95e0d-39ff-4447-bc30-9d1943312f9b

	measure 'Fulfilment Cost' = SUM ( FactSales[FulfilmentCostEUR] )
		formatString: \€#,0
		displayFolder: 2 Costs
		lineageTag: 7b939050-7393-4c9d-89f8-b635ea1ec95e

	measure 'Payment Fees' = SUM ( FactSales[PaymentFeesEUR] )
		formatString: \€#,0
		displayFolder: 2 Costs
		lineageTag: 1d8897af-d2bf-448e-80da-cc6f1b0d88ff

	measure 'Return Handling Cost' = SUM ( FactSales[ReturnHandlingCostEUR] )
		formatString: \€#,0
		displayFolder: 2 Costs
		lineageTag: 554276fb-5bd1-4833-ae93-c8cfc01a893a

	/// Event budget allocated to lines by gross sales share. Zero for regular trading.
	measure 'Campaign Spend' = SUM ( FactSales[AllocatedCampaignSpendEUR] )
		formatString: \€#,0
		displayFolder: 2 Costs
		lineageTag: f44497c4-c716-4f65-be61-c8786411fd51

	measure 'Selling Costs' = [Fulfilment Cost] + [Payment Fees] + [Return Handling Cost] + [Campaign Spend]
		formatString: \€#,0
		displayFolder: 2 Costs
		lineageTag: c415b0d5-4f22-4070-aa5d-e599895ab8f7

	measure 'Gross Profit' = SUM ( FactSales[GrossProfitEUR] )
		formatString: \€#,0
		displayFolder: 3 Profit
		lineageTag: b566fd1b-ceec-4f17-841c-bed42127b8f4

	/// Gross profit less fulfilment, payment fees, return handling and campaign spend. Excludes overhead, interest and tax.
	measure 'Contribution Profit' = SUM ( FactSales[ContributionProfitEUR] )
		formatString: \€#,0;-\€#,0
		displayFolder: 3 Profit
		lineageTag: ad54d518-909f-4322-95b0-c0152c8d4346

	measure 'Units Sold' = SUM ( FactSales[UnitsSold] )
		formatString: #,0
		displayFolder: 4 Volume
		lineageTag: 9999d350-b026-4f15-b54f-fba534e23678

	measure 'Returned Units' = SUM ( FactSales[ReturnedUnits] )
		formatString: #,0
		displayFolder: 4 Volume
		lineageTag: dae8efbc-dde6-4691-9530-e4da36887049

	measure Orders = DISTINCTCOUNT ( FactSales[OrderID] )
		formatString: #,0
		displayFolder: 4 Volume
		lineageTag: 1e5380d2-c96f-40e9-bdc0-5547ee587b9d

	measure 'Sales Lines' = COUNTROWS ( FactSales )
		formatString: #,0
		displayFolder: 4 Volume
		lineageTag: 157b4165-7167-4838-a543-632cc3e34f30

	/// Days with at least one sale in the current filter context.
	measure 'Trading Days' = DISTINCTCOUNT ( FactSales[SaleDate] )
		formatString: #,0
		displayFolder: 4 Volume
		lineageTag: 7db7392a-a677-41db-a889-c83fcb19e75f

	/// Discount amount / gross sales (value-weighted).
	measure 'Weighted Discount %' = DIVIDE ( [Discount Amount], [Gross Sales] )
		formatString: 0.0%
		displayFolder: 5 Ratios
		lineageTag: 924622a6-0cff-4f09-a108-7f65bca14629

	measure 'Contribution Margin %' = DIVIDE ( [Contribution Profit], [Net Sales] )
		formatString: 0.0%;-0.0%
		displayFolder: 5 Ratios
		lineageTag: 5697c522-c60c-45da-a877-c8f438d0734d

	measure 'Gross Margin %' = DIVIDE ( [Gross Profit], [Net Sales] )
		formatString: 0.0%;-0.0%
		displayFolder: 5 Ratios
		lineageTag: bb8d6be6-265d-4b27-a45a-120228b33908

	/// Returned units / units sold.
	measure 'Return Rate %' = DIVIDE ( [Returned Units], [Units Sold] )
		formatString: 0.0%
		displayFolder: 5 Ratios
		lineageTag: 72dec40d-19a6-4273-9dab-351640403403

	measure 'Refund Rate %' = DIVIDE ( [Refunds], [Sales After Discount] )
		formatString: 0.0%
		displayFolder: 5 Ratios
		lineageTag: 5cc17aeb-13b5-4edb-ad65-dbb324e16652

	measure 'Avg Order Value' = DIVIDE ( [Net Sales], [Orders] )
		formatString: \€#,0
		displayFolder: 5 Ratios
		lineageTag: a456236a-39e0-43d7-899c-57ae0f863c20

	measure 'Contribution per €100 Gross' = DIVIDE ( [Contribution Profit], [Gross Sales] ) * 100
		formatString: \€#,0.0;-\€#,0.0
		displayFolder: 5 Ratios
		lineageTag: 3a0a8f06-b443-433f-bd1f-6e1a7b11c93f

	/// Net sales / days with sales. Use to compare 3-day events with 15-17 day events fairly.
	measure 'Net Sales per Day' = DIVIDE ( [Net Sales], [Trading Days] )
		formatString: \€#,0
		displayFolder: 6 Daily
		lineageTag: ba909cd6-2e22-4a95-a7a3-2e9f7640adef

	measure 'Contribution per Day' = DIVIDE ( [Contribution Profit], [Trading Days] )
		formatString: \€#,0;-\€#,0
		displayFolder: 6 Daily
		lineageTag: 1ef76a34-c12f-4607-b1f6-63ee4a17b1dd

	measure 'Orders per Day' = DIVIDE ( [Orders], [Trading Days] )
		formatString: #,0.0
		displayFolder: 6 Daily
		lineageTag: 86f3b3aa-ba5f-4ead-80d2-79db9526b809

	measure 'COGS per € Net' = DIVIDE ( [Net COGS], [Net Sales] )
		formatString: 0%;-0%
		displayFolder: 7 Cost per €
		lineageTag: b2e7100b-c7a7-4cba-9351-a2f8ad9a51c4

	measure 'Fulfilment and Fees per € Net' = DIVIDE ( [Fulfilment Cost] + [Payment Fees], [Net Sales] )
		formatString: 0%;-0%
		displayFolder: 7 Cost per €
		lineageTag: d997f1e3-39b5-45c4-82a4-e686fa8d8262

	measure 'Return Handling per € Net' = DIVIDE ( [Return Handling Cost], [Net Sales] )
		formatString: 0%;-0%
		displayFolder: 7 Cost per €
		lineageTag: 49b649b6-68e1-4ff8-925b-72fb5250f511

	measure 'Campaign Spend per € Net' = DIVIDE ( [Campaign Spend], [Net Sales] )
		formatString: 0%;-0%
		displayFolder: 7 Cost per €
		lineageTag: 643f323f-a0b8-46d1-b9de-c4a82043b0a5

	measure 'Contribution per € Net' = DIVIDE ( [Contribution Profit], [Net Sales] )
		formatString: 0%;-0%
		displayFolder: 7 Cost per €
		lineageTag: d013e6a7-a7dd-4c01-9325-e73410aeb5ff

	measure 'Campaign Net Sales' = CALCULATE ( [Net Sales], DimCampaign[IsCampaign] = 1 )
		formatString: \€#,0
		displayFolder: 8 Campaign vs regular
		lineageTag: 2602538d-1250-4ce1-9b93-8476c47fa576

	measure 'Regular Net Sales' = CALCULATE ( [Net Sales], DimCampaign[IsCampaign] = 0 )
		formatString: \€#,0
		displayFolder: 8 Campaign vs regular
		lineageTag: 2694e3e7-a4f4-455b-a65e-8237b63597e3

	measure 'Campaign Contribution' = CALCULATE ( [Contribution Profit], DimCampaign[IsCampaign] = 1 )
		formatString: \€#,0;-\€#,0
		displayFolder: 8 Campaign vs regular
		lineageTag: 4ae1d84c-1bfd-4590-b0d5-52918226f841

	measure 'Regular Contribution' = CALCULATE ( [Contribution Profit], DimCampaign[IsCampaign] = 0 )
		formatString: \€#,0;-\€#,0
		displayFolder: 8 Campaign vs regular
		lineageTag: d9409cf4-1ae8-4712-b00b-f576a7a1612f

	measure 'Campaign Share of Net Sales' = DIVIDE ( [Campaign Net Sales], [Campaign Net Sales] + [Regular Net Sales] )
		formatString: 0%
		displayFolder: 8 Campaign vs regular
		lineageTag: 0abbf00e-742a-4685-a4f2-b6174586b793

	measure 'Campaign Share of Contribution' = DIVIDE ( [Campaign Contribution], [Campaign Contribution] + [Regular Contribution] )
		formatString: 0%;-0%
		displayFolder: 8 Campaign vs regular
		lineageTag: a2b7dcf9-ea6f-4524-9f37-cd9eb7fcfecd

	measure 'Campaign Margin %' = CALCULATE ( [Contribution Margin %], DimCampaign[IsCampaign] = 1 )
		formatString: 0.0%;-0.0%
		displayFolder: 8 Campaign vs regular
		lineageTag: 0f195b06-6907-4d4a-93b9-b94b0e2ee6ab

	measure 'Regular Margin %' = CALCULATE ( [Contribution Margin %], DimCampaign[IsCampaign] = 0 )
		formatString: 0.0%;-0.0%
		displayFolder: 8 Campaign vs regular
		lineageTag: e56c2aae-8b07-42f7-a371-0d8e33be2de5

	/// Baseline: regular-trading net sales per day in the current season/market/channel context.
	measure 'Regular Net Sales per Day' = CALCULATE ( [Net Sales per Day], REMOVEFILTERS ( DimCampaign ), DimCampaign[IsCampaign] = 0 )
		formatString: \€#,0
		displayFolder: 8 Campaign vs regular
		lineageTag: 478b9fbc-8919-45b3-a9c1-8195a96f4fad

	measure 'Sales per Day vs Regular' = DIVIDE ( [Net Sales per Day], [Regular Net Sales per Day] )
		formatString: 0.0x
		displayFolder: 8 Campaign vs regular
		lineageTag: 9bcd2807-6eb2-48b4-b4fe-c89b109350b5

	measure 'Loss-making Net Sales' = CALCULATE ( [Net Sales], FactSales[ContributionProfitEUR] < 0 )
		formatString: \€#,0
		displayFolder: 3 Profit
		lineageTag: 4c385c08-837b-47ae-b7be-83df543abc7f

	measure 'Loss-making Share of Net Sales' = DIVIDE ( [Loss-making Net Sales], [Net Sales] )
		formatString: 0%
		displayFolder: 3 Profit
		lineageTag: 81c1ddfb-2e90-48bc-a105-e4e183cbf1de

	measure 'Net Sales Share' = DIVIDE ( [Net Sales], CALCULATE ( [Net Sales], ALLSELECTED () ) )
		formatString: 0.0%
		displayFolder: 5 Ratios
		lineageTag: 3b79325d-f705-4201-94f2-d2096de57bca

	measure 'Contribution Share' = DIVIDE ( [Contribution Profit], CALCULATE ( [Contribution Profit], ALLSELECTED () ) )
		formatString: 0.0%;-0.0%
		displayFolder: 5 Ratios
		lineageTag: 6aab2320-e564-41e4-929a-177829e89950

	/// Signed values for the profit bridge. Mark Contribution Profit as total in the visual.
	measure 'Profit Step Value' =
			SWITCH ( SELECTEDVALUE ( 'Profit Steps'[Step] ),
			    "Gross Sales", [Gross Sales],
			    "Discounts", -[Discount Amount],
			    "Refunds", -[Refunds],
			    "Net COGS", -[Net COGS],
			    "Fulfilment", -[Fulfilment Cost],
			    "Payment Fees", -[Payment Fees],
			    "Return Handling", -[Return Handling Cost],
			    "Campaign Spend", -[Campaign Spend],
			    "Contribution Profit", [Contribution Profit]
			)
		formatString: \€#,0;-\€#,0
		displayFolder: 9 Bridge
		lineageTag: 73317a5c-d79b-4262-9f2b-482d02b5c142

	measure 'Profit Step per €100 Gross' = DIVIDE ( [Profit Step Value], [Gross Sales] ) * 100
		formatString: \€#,0.0;-\€#,0.0
		displayFolder: 9 Bridge
		lineageTag: 35eae82a-c8bd-46ec-8a8a-38fc57db8d23

	/// Steps only (no totals) for waterfalls that add the total automatically.
	measure 'Profit Step Movement' = IF ( SELECTEDVALUE ( 'Profit Steps'[Step] ) IN { "Gross Sales", "Contribution Profit" }, BLANK (), [Profit Step Value] )
		formatString: \€#,0;-\€#,0
		displayFolder: 9 Bridge
		lineageTag: 922cf473-f7ae-4981-9f12-06a4c2f9f7ef

	measure 'Title Bridge' =
			VAR g = [Gross Sales]
			VAR per = DIVIDE ( [Contribution Profit], g ) * 100
			VAR leaks = { ( "discounts", [Discount Amount] ), ( "refunds", [Refunds] ), ( "campaign spend", [Campaign Spend] ), ( "fulfilment", [Fulfilment Cost] ), ( "payment fees", [Payment Fees] ), ( "return handling", [Return Handling Cost] ) }
			VAR topLeak = TOPN ( 1, leaks, [Value2], DESC )
			VAR nm = MAXX ( topLeak, [Value1] )
			VAR amt = DIVIDE ( MAXX ( topLeak, [Value2] ), g ) * 100
			RETURN
			    IF ( ISBLANK ( g ), "No sales in this selection",
			        IF ( per >= 0, "Of every €100 of gross sales, €" & FORMAT ( per, "0.0" ) & " survives as contribution", "Every €100 of gross sales loses €" & FORMAT ( -per, "0.0" ) & " after all costs" )
			        & " — biggest leak after product cost: " & nm & " (€" & FORMAT ( amt, "0.0" ) & ")" )
		displayFolder: 10 Titles\Overview
		lineageTag: 4bf45ea6-c0d1-46fe-a3a2-033de880127d

	measure 'Title Campaign Daily' =
			VAR t = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DimCampaign[Campaign Type] ), DimCampaign[IsCampaign] = 1 ), "@d", [Net Sales per Day], "@m", [Contribution Margin %] )
			VAR tt = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@d] ) ), [@d], DESC )
			VAR nm = MAXX ( tt, DimCampaign[Campaign Type] )
			VAR d = MAXX ( tt, [@d] )
			VAR m = MAXX ( tt, [@m] )
			VAR x = DIVIDE ( d, [Regular Net Sales per Day] )
			RETURN
			    IF ( ISBLANK ( nm ),
			        "Regular trading: " & FORMAT ( [Net Sales per Day] / 1000, "\€#,0.0\k" ) & " net sales a day at " & FORMAT ( [Contribution Margin %], "0.0%;−0.0%" ) & " margin",
			        nm & " sells " & FORMAT ( d / 1000, "\€#,0.0\k" ) & " a day" & IF ( NOT ISBLANK ( x ), ", " & FORMAT ( x, "0.0" ) & "× regular trading,", "" ) & IF ( m < 0.1, " yet runs a ", " and keeps a " ) & FORMAT ( m, "0.0%;−0.0%" ) & " margin" )
		displayFolder: 10 Titles\Overview
		lineageTag: 84993e53-1b54-41ec-a63c-89f2b6e5d2e6

	measure 'Hero Contribution' = FORMAT ( [Contribution Profit] / 1000, "\€#,0.0\k;−\€#,0.0\k" )
		displayFolder: 10 Titles\Overview
		lineageTag: 024b5e70-0995-4ba0-a0bb-cd16b45b92c3

	measure 'Hero Subtitle' =
			VAR n = [Net Sales]
			RETURN "contribution profit on " & IF ( n >= 1000000, FORMAT ( n / 1000000, "\€#,0.00\M" ), FORMAT ( n / 1000, "\€#,0.0\k" ) ) & " net sales · " & FORMAT ( [Contribution Margin %], "0.0%;−0.0%" ) & " margin"
		displayFolder: 10 Titles\Overview
		lineageTag: 0daf4d0f-c5ce-456d-a817-1a12eaab026d

	measure 'Hero Campaign Line' =
			VAR s = [Campaign Share of Net Sales]
			VAR c = [Campaign Share of Contribution]
			RETURN IF ( ISBLANK ( s ) || s = 0, "No campaign sales in this selection", "Campaigns: " & FORMAT ( s, "0%" ) & " of net sales, " & FORMAT ( c, "0%;−0%" ) & " of contribution" )
		displayFolder: 10 Titles\Overview
		lineageTag: 9b0a1bcd-2402-4689-a447-7ebaa11dd162

	measure 'Note Heads Up' =
			VAR t = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DimCampaign[Campaign] ), DimCampaign[IsCampaign] = 1 ), "@cp", [Contribution Profit], "@d", [Weighted Discount %] )
			VAR w = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@cp] ) ), [@cp], ASC )
			VAR nm = MAXX ( w, DimCampaign[Campaign] )
			VAR cp = MAXX ( w, [@cp] )
			VAR d = MAXX ( w, [@d] )
			RETURN
			    IF ( ISBLANK ( nm ), "No campaign sales in this selection",
			        IF ( cp < 0, nm & " lost " & FORMAT ( -cp / 1000, "\€#,0.0\k" ) & " at a " & FORMAT ( d, "0%" ) & " average discount", "Weakest campaign: " & nm & " earned only " & FORMAT ( cp / 1000, "\€#,0.0\k" ) ) )
		displayFolder: 10 Titles\Overview
		lineageTag: 20626a7e-c749-4989-9505-b4d09fea498c

	measure 'Note Watch' =
			VAR b = ADDCOLUMNS ( SUMMARIZE ( FactSales, FactSales[Discount Band], FactSales[DiscountBandSort] ), "@m", [Contribution Margin %] )
			VAR neg = TOPN ( 1, FILTER ( b, [@m] < 0 ), FactSales[DiscountBandSort], ASC )
			VAR nb = MAXX ( neg, FactSales[Discount Band] )
			VAR nm = MAXX ( neg, [@m] )
			VAR low = TOPN ( 1, b, [@m], ASC )
			RETURN
			    IF ( NOT ISBLANK ( nb ), "Margin turns negative from the " & nb & " discount band (" & FORMAT ( nm, "0.0%;−0.0%" ) & ")",
			        IF ( COUNTROWS ( b ) = 0, "No sales in this selection", "Margin stays positive at every discount level (lowest " & FORMAT ( MAXX ( low, [@m] ), "0.0%" ) & " at " & MAXX ( low, FactSales[Discount Band] ) & ")" ) )
		displayFolder: 10 Titles\Overview
		lineageTag: cdfd3dff-da21-472e-a067-8bba77dd3e3f

	measure 'Note Small Win' =
			VAR t = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DimCampaign[Campaign] ), DimCampaign[IsCampaign] = 1 ), "@m", [Contribution Margin %], "@n", [Net Sales], "@d", [Weighted Discount %] )
			VAR b = TOPN ( 1, FILTER ( t, [@n] > 0 ), [@m], DESC )
			VAR nm = MAXX ( b, DimCampaign[Campaign] )
			VAR m = MAXX ( b, [@m] )
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( nm ), "Regular trading keeps a " & FORMAT ( [Contribution Margin %], "0.0%;−0.0%" ) & " margin with almost no discounting",
			        m < 0, "No campaign made money here; " & nm & " came closest at " & FORMAT ( m, "0.0%;−0.0%" ),
			        nm & " kept a " & FORMAT ( m, "0.0%" ) & " margin on " & FORMAT ( MAXX ( b, [@n] ) / 1000, "\€#,0.0\k" ) & " net sales at a " & FORMAT ( MAXX ( b, [@d] ), "0%" ) & " discount" )
		displayFolder: 10 Titles\Overview
		lineageTag: ba60d01f-0dd2-4d39-a207-39e79170dead

	measure 'Title Cost Strip' =
			VAR cm = [Contribution per € Net]
			RETURN
			    IF ( ISBLANK ( [Net Sales] ), "No sales in this selection",
			        "Each €1 of net sales: " & FORMAT ( [COGS per € Net] * 100, "0" ) & "c product cost, " & FORMAT ( [Campaign Spend per € Net] * 100, "0" ) & "c campaign spend, " & FORMAT ( ( [Fulfilment and Fees per € Net] + [Return Handling per € Net] ) * 100, "0" ) & "c fulfilment, fees and returns — " & IF ( cm >= 0, FORMAT ( cm * 100, "0" ) & "c left as contribution", FORMAT ( -cm * 100, "0" ) & "c lost" ) )
		displayFolder: 10 Titles\Overview
		lineageTag: eb7632bf-6978-4bbe-a83c-aa28b0e5874e

	measure 'KPI Net Sales Sub' = FORMAT ( [Net Sales per Day] / 1000, "\€#,0.0\k" ) & " a trading day · " & FORMAT ( [Orders], "#,0" ) & " orders"
		displayFolder: 10 Titles\KPI
		lineageTag: e2fec032-b37c-4b0a-ad8f-d756ce943264

	measure 'KPI Margin Sub' = "Campaigns " & IF ( ISBLANK ( [Campaign Margin %] ), "–", FORMAT ( [Campaign Margin %], "0.0%;−0.0%" ) ) & " · Regular " & IF ( ISBLANK ( [Regular Margin %] ), "–", FORMAT ( [Regular Margin %], "0.0%;−0.0%" ) )
		displayFolder: 10 Titles\KPI
		lineageTag: a6020918-4dde-46fb-9eab-d799460bafe0

	measure 'KPI Discount Sub' = FORMAT ( [Discount Amount] / 1000, "\€#,0.0\k" ) & " given away on " & IF ( [Gross Sales] >= 1000000, FORMAT ( [Gross Sales] / 1000000, "\€#,0.00\M" ), FORMAT ( [Gross Sales] / 1000, "\€#,0.0\k" ) ) & " gross"
		displayFolder: 10 Titles\KPI
		lineageTag: 059ff753-bb53-4f79-83ce-43e979cb6ec1

	measure 'KPI Return Sub' = FORMAT ( [Returned Units], "#,0" ) & " units back · " & FORMAT ( [Refunds] / 1000, "\€#,0.0\k" ) & " refunded"
		displayFolder: 10 Titles\KPI
		lineageTag: eb574233-c3e7-4606-9164-e3a4540671e9

	measure 'Title Campaign Scorecard' =
			VAR t = FILTER ( ADDCOLUMNS ( CALCULATETABLE ( VALUES ( DimCampaign[Campaign Type] ), DimCampaign[IsCampaign] = 1 ), "@m", [Contribution Margin %], "@cp", [Contribution Profit] ), NOT ISBLANK ( [@cp] ) )
			VAR best = TOPN ( 1, t, [@m], DESC )
			VAR worst = TOPN ( 1, t, [@cp], ASC )
			VAR nDouble = COUNTROWS ( FILTER ( t, [@m] >= 0.1 ) )
			VAR bn = MAXX ( best, DimCampaign[Campaign Type] )
			VAR bm = MAXX ( best, [@m] )
			VAR wn = MAXX ( worst, DimCampaign[Campaign Type] )
			VAR wcp = MAXX ( worst, [@cp] )
			RETURN
			    SWITCH ( TRUE (),
			        COUNTROWS ( t ) = 0, "No campaign sales in this selection",
			        COUNTROWS ( t ) = 1, bn & " runs a " & FORMAT ( bm, "0.0%;−0.0%" ) & " margin (" & FORMAT ( wcp / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & " contribution)",
			        bm < 0, "Every campaign type lost money here; " & bn & " came closest (" & FORMAT ( bm, "0.0%;−0.0%" ) & "), " & wn & " lost " & FORMAT ( -wcp / 1000, "\€#,0.0\k" ),
			        IF ( nDouble = 1, "Only " & bn & " earns a double-digit margin (" & FORMAT ( bm, "0.0%" ) & ")", bn & " leads at a " & FORMAT ( bm, "0.0%" ) & " margin" )
			            & "; " & wn & IF ( wcp < 0, " loses " & FORMAT ( -wcp / 1000, "\€#,0.0\k" ), " trails with " & FORMAT ( wcp / 1000, "\€#,0.0\k" ) ) )
		displayFolder: 10 Titles\Campaigns
		lineageTag: a4574180-5907-4fa2-ac20-fe8836bdc4da

	measure 'Title Discount Curve' =
			VAR b = ADDCOLUMNS ( SUMMARIZE ( FactSales, FactSales[Discount Band], FactSales[DiscountBandSort] ), "@m", [Contribution Margin %] )
			VAR base = MAXX ( FILTER ( b, FactSales[DiscountBandSort] = 0 ), [@m] )
			VAR neg = TOPN ( 1, FILTER ( b, [@m] < 0 ), FactSales[DiscountBandSort], ASC )
			VAR nb = MAXX ( neg, FactSales[Discount Band] )
			VAR low = TOPN ( 1, b, [@m], ASC )
			RETURN
			    IF ( NOT ISBLANK ( nb ),
			        "Margin turns negative once discounts reach " & nb & " (" & FORMAT ( MAXX ( neg, [@m] ), "0.0%;−0.0%" ) & ")" & IF ( NOT ISBLANK ( base ), " — vs " & FORMAT ( base, "0.0%" ) & " with no discount", "" ),
			        IF ( COUNTROWS ( b ) = 0, "No sales in this selection", "Margin holds above zero at every discount level; lowest is " & FORMAT ( MAXX ( low, [@m] ), "0.0%" ) & " at " & MAXX ( low, FactSales[Discount Band] ) ) )
		displayFolder: 10 Titles\Campaigns
		lineageTag: 99dd7092-f1dd-40d6-823c-b150b7d7e548

	measure 'Title Discount Scatter' =
			VAR pts = FILTER ( ADDCOLUMNS ( VALUES ( DimCampaign[Campaign] ), "@x", [Weighted Discount %], "@y", [Contribution Margin %] ), NOT ISBLANK ( [@y] ) )
			VAR n = COUNTROWS ( pts )
			VAR fit = LINESTX ( pts, [@y], [@x] )
			VAR slope = MAXX ( fit, [Slope1] )
			RETURN
			    IF ( n < 3, "Select three or more campaigns to see the discount-to-margin trend",
			        IF ( slope < 0, "Each extra 10 pts of discount costs about " & FORMAT ( -slope * 10, "0.0" ) & " pts of margin across " & n & " campaigns", "Deeper discounts did not cut margin across these " & n & " campaigns" ) )
		displayFolder: 10 Titles\Campaigns
		lineageTag: 186386cd-83ed-4f14-867c-1b8bfef6396b

	measure 'Title Peak Day' =
			VAR t = ADDCOLUMNS ( VALUES ( DimDate[Date] ), "@n", [Net Sales], "@cp", [Contribution Profit] )
			VAR pk = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [@n] ) ), [@n], DESC )
			VAR dt = MAXX ( pk, DimDate[Date] )
			VAR n = MAXX ( pk, [@n] )
			VAR cp = MAXX ( pk, [@cp] )
			VAR k = CALCULATE ( MAX ( FactSales[CampaignKey] ), DimDate[Date] = dt )
			VAR camp = LOOKUPVALUE ( DimCampaign[Campaign], DimCampaign[CampaignKey], k )
			RETURN
			    IF ( ISBLANK ( dt ), "No sales in this selection",
			        "Peak day " & FORMAT ( dt, "d mmm yyyy" ) & " (" & camp & ") sold " & FORMAT ( n / 1000, "\€#,0.0\k" ) & IF ( cp < 0, " but lost " & FORMAT ( -cp / 1000, "\€#,0.0\k" ), " and earned " & FORMAT ( cp / 1000, "\€#,0.0\k" ) ) )
		displayFolder: 10 Titles\Campaigns
		lineageTag: f821560f-ca6c-4972-98c4-b9c0ee71be99

	measure 'Title Heatmap' =
			VAR t = FILTER ( ADDCOLUMNS ( SUMMARIZE ( FactSales, DimProduct[Category], FactSales[Discount Band] ), "@m", [Contribution Margin %], "@n", [Net Sales] ), [@n] >= 5000 )
			VAR w = TOPN ( 1, t, [@m], ASC )
			VAR b = TOPN ( 1, t, [@m], DESC )
			VAR wb = MAXX ( w, FactSales[Discount Band] )
			VAR bb = MAXX ( b, FactSales[Discount Band] )
			VAR wm = MAXX ( w, [@m] )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "Not enough sales in this selection",
			        IF ( wm < 0, "Deepest loss: ", "Lowest margin: " ) & MAXX ( w, DimProduct[Category] ) & IF ( wb = "No discount", " with no discount", " at " & wb & " off" ) & " (" & FORMAT ( wm, "0.0%;−0.0%" ) & ") · best: " & MAXX ( b, DimProduct[Category] ) & IF ( bb = "No discount", " with no discount", " at " & bb & " off" ) & " (" & FORMAT ( MAXX ( b, [@m] ), "0.0%" ) & ")" )
		displayFolder: 10 Titles\Campaigns
		lineageTag: 85bea2bc-eb18-4b91-84ae-49af62ce9c01

	measure 'Title Season' =
			VAR t = ADDCOLUMNS ( SUMMARIZE ( FactSales, DimDate[Season], DimDate[HolidaySeasonSort] ), "@m", [Campaign Margin %], "@d", CALCULATE ( [Weighted Discount %], DimCampaign[IsCampaign] = 1 ) )
			VAR t2 = FILTER ( t, NOT ISBLANK ( [@m] ) )
			VAR lastS = TOPN ( 1, t2, DimDate[HolidaySeasonSort], DESC )
			VAR ls = MAXX ( lastS, DimDate[HolidaySeasonSort] )
			VAR prevS = TOPN ( 1, FILTER ( t2, DimDate[HolidaySeasonSort] < ls ), DimDate[HolidaySeasonSort], DESC )
			VAR lm = MAXX ( lastS, [@m] )
			VAR pm = MAXX ( prevS, [@m] )
			VAR ld = MAXX ( lastS, [@d] )
			VAR pd = MAXX ( prevS, [@d] )
			RETURN
			    IF ( COUNTROWS ( t2 ) < 2,
			        IF ( COUNTROWS ( t2 ) = 1, MAXX ( lastS, DimDate[Season] ) & " campaigns: " & FORMAT ( lm, "0.0%;−0.0%" ) & " margin at " & FORMAT ( ld, "0.0%" ) & " discount", "No campaign sales in this selection" ),
			        "Campaign margin " & IF ( lm >= pm, "recovered", "slipped" ) & " to " & FORMAT ( lm, "0.0%;−0.0%" ) & " in " & MAXX ( lastS, DimDate[Season] ) & " (from " & FORMAT ( pm, "0.0%;−0.0%" ) & ") as discounts " & IF ( ld <= pd, "eased", "rose" ) & " to " & FORMAT ( ld, "0.0%" ) )
		displayFolder: 10 Titles\Campaigns
		lineageTag: 12c29df9-5c37-45dc-b878-62f9bcbaab54

	measure 'Title Category' =
			VAR totN = [Net Sales]
			VAR totC = [Contribution Profit]
			VAR t = ADDCOLUMNS ( VALUES ( DimProduct[Category] ), "@s", DIVIDE ( [Net Sales], totN ), "@c", DIVIDE ( [Contribution Profit], totC ) )
			VAR t2 = FILTER ( t, NOT ISBLANK ( [@s] ) )
			VAR g = TOPN ( 1, t2, [@s] - [@c], DESC )
			VAR p = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( DimProduct[Product] ), "@cp", [Contribution Profit], "@n", [Net Sales] ), NOT ISBLANK ( [@n] ) ), [@cp], ASC )
			RETURN
			    IF ( COUNTROWS ( t2 ) > 1,
			        MAXX ( g, DimProduct[Category] ) & " brings " & FORMAT ( MAXX ( g, [@s] ), "0%" ) & " of net sales but " & IF ( MAXX ( g, [@c] ) < 0, "drags contribution down", "just " & FORMAT ( MAXX ( g, [@c] ), "0%" ) & " of contribution" ),
			        IF ( COUNTROWS ( p ) = 0, "No sales in this selection", MAXX ( p, DimProduct[Product] ) & IF ( MAXX ( p, [@cp] ) < 0, " loses " & FORMAT ( -MAXX ( p, [@cp] ) / 1000, "\€#,0.0\k" ), " earns the least (" & FORMAT ( MAXX ( p, [@cp] ) / 1000, "\€#,0.0\k" ) & ")" ) & " on " & FORMAT ( MAXX ( p, [@n] ) / 1000, "\€#,0.0\k" ) & " net sales" ) )
		displayFolder: 10 Titles\Products
		lineageTag: 248a20ef-4666-411d-aabf-18126aa97057

	measure 'Title Map' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( DimLocation[City] ), "@n", [Net Sales], "@m", [Contribution Margin %] ), NOT ISBLANK ( [@n] ) )
			VAR big = TOPN ( 1, t, [@n], DESC )
			VAR best = TOPN ( 1, t, [@m], DESC )
			VAR bc = MAXX ( big, DimLocation[City] )
			VAR sc = MAXX ( best, DimLocation[City] )
			RETURN
			    SWITCH ( TRUE (),
			        COUNTROWS ( t ) = 0, "No sales in this selection",
			        COUNTROWS ( t ) = 1, bc & ": " & FORMAT ( MAXX ( big, [@n] ) / 1000, "\€#,0.0\k" ) & " net sales at a " & FORMAT ( MAXX ( big, [@m] ), "0.0%;−0.0%" ) & " margin",
			        bc = sc, bc & " leads on both sales (" & FORMAT ( MAXX ( big, [@n] ) / 1000, "\€#,0.0\k" ) & ") and margin (" & FORMAT ( MAXX ( big, [@m] ), "0.0%" ) & ")",
			        bc & " is the largest market (" & FORMAT ( MAXX ( big, [@n] ) / 1000, "\€#,0.0\k" ) & ") but keeps " & FORMAT ( MAXX ( big, [@m] ), "0.0%;−0.0%" ) & "; " & sc & " keeps the most (" & FORMAT ( MAXX ( best, [@m] ), "0.0%" ) & ")" )
		displayFolder: 10 Titles\Products
		lineageTag: 51e9ddeb-8ecd-430b-93af-0d85301bece0

	measure 'Title Channel' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( FactSales[Sales Channel] ), "@n", [Net Sales], "@m", [Contribution Margin %] ), NOT ISBLANK ( [@n] ) )
			VAR hi = TOPN ( 1, t, [@n], DESC )
			VAR lo = TOPN ( 1, t, [@n], ASC )
			VAR hm = MAXX ( hi, [@m] )
			VAR lm = MAXX ( lo, [@m] )
			RETURN
			    IF ( COUNTROWS ( t ) < 2,
			        IF ( COUNTROWS ( t ) = 0, "No sales in this selection", MAXX ( hi, FactSales[Sales Channel] ) & " keeps a " & FORMAT ( hm, "0.0%;−0.0%" ) & " margin on " & FORMAT ( MAXX ( hi, [@n] ) / 1000, "\€#,0.0\k" ) ),
			        MAXX ( hi, FactSales[Sales Channel] ) & " sells " & FORMAT ( DIVIDE ( MAXX ( hi, [@n] ), MAXX ( lo, [@n] ) ), "0.0" ) & "× " & LOWER ( MAXX ( lo, FactSales[Sales Channel] ) ) & IF ( hm < lm, " but keeps ", " and keeps " ) & FORMAT ( hm, "0.0%;−0.0%" ) & " vs " & FORMAT ( lm, "0.0%;−0.0%" ) )
		displayFolder: 10 Titles\Products
		lineageTag: 7d1e1d82-9654-4664-8fae-aec8070a0ac1

	measure 'Title Segment' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( FactSales[Customer Segment] ), "@cp", [Contribution Profit], "@r", [Return Rate %] ), NOT ISBLANK ( [@cp] ) )
			VAR topSeg = TOPN ( 1, t, [@cp], DESC )
			VAR retSeg = TOPN ( 1, t, [@r], DESC )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "No sales in this selection",
			        MAXX ( topSeg, FactSales[Customer Segment] ) & " earn the most contribution (" & FORMAT ( MAXX ( topSeg, [@cp] ) / 1000, "\€#,0.0\k;−\€#,0.0\k" ) & ")" & IF ( COUNTROWS ( t ) > 1, "; " & LOWER ( MAXX ( retSeg, FactSales[Customer Segment] ) ) & " return the most (" & FORMAT ( MAXX ( retSeg, [@r] ), "0.0%" ) & " of units)", "" ) )
		displayFolder: 10 Titles\Products
		lineageTag: 4702bca0-468c-4933-8132-b12faa6fe165

	measure 'Title Returns' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( DimProduct[Category] ), "@r", [Return Rate %] ), NOT ISBLANK ( [@r] ) )
			VAR hi = TOPN ( 1, t, [@r], DESC )
			VAR lo = TOPN ( 1, t, [@r], ASC )
			RETURN
			    IF ( COUNTROWS ( t ) < 2,
			        IF ( COUNTROWS ( t ) = 0, "No sales in this selection", MAXX ( hi, DimProduct[Category] ) & " returns " & FORMAT ( MAXX ( hi, [@r] ), "0.0%" ) & " of units sold" ),
			        MAXX ( hi, DimProduct[Category] ) & " returns " & FORMAT ( MAXX ( hi, [@r] ), "0.0%" ) & " of units — " & FORMAT ( DIVIDE ( MAXX ( hi, [@r] ), MAXX ( lo, [@r] ) ), "0.0" ) & "× " & MAXX ( lo, DimProduct[Category] ) & " (" & FORMAT ( MAXX ( lo, [@r] ), "0.0%" ) & ")" )
		displayFolder: 10 Titles\Products
		lineageTag: 165b1e1f-ddbb-41cc-b819-e8668817c66d

	measure 'Title Cost Structure' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( FactSales[Sales Channel] ), "@m", [Contribution Margin %] ), NOT ISBLANK ( [@m] ) )
			VAR w = TOPN ( 1, t, [@m], ASC )
			VAR b = TOPN ( 1, t, [@m], DESC )
			VAR wn = MAXX ( w, FactSales[Sales Channel] )
			VAR bn = MAXX ( b, FactSales[Sales Channel] )
			VAR wm = MAXX ( w, [@m] )
			VAR keepTxt = IF ( wm < 0, " loses " & FORMAT ( -wm * 100, "0" ), " keeps " & FORMAT ( wm * 100, "0" ) )
			VAR gaps = {
			    ( "product cost", CALCULATE ( [COGS per € Net], FactSales[Sales Channel] = wn ) - CALCULATE ( [COGS per € Net], FactSales[Sales Channel] = bn ) ),
			    ( "fulfilment and fees", CALCULATE ( [Fulfilment and Fees per € Net], FactSales[Sales Channel] = wn ) - CALCULATE ( [Fulfilment and Fees per € Net], FactSales[Sales Channel] = bn ) ),
			    ( "return handling", CALCULATE ( [Return Handling per € Net], FactSales[Sales Channel] = wn ) - CALCULATE ( [Return Handling per € Net], FactSales[Sales Channel] = bn ) ),
			    ( "campaign spend", CALCULATE ( [Campaign Spend per € Net], FactSales[Sales Channel] = wn ) - CALCULATE ( [Campaign Spend per € Net], FactSales[Sales Channel] = bn ) ) }
			VAR g = TOPN ( 1, gaps, [Value2], DESC )
			RETURN
			    IF ( COUNTROWS ( t ) < 2,
			        IF ( COUNTROWS ( t ) = 0, "No sales in this selection", wn & keepTxt & "c of each €1 of net sales" ),
			        wn & keepTxt & "c of each €1 vs " & FORMAT ( MAXX ( b, [@m] ) * 100, "0;−0" ) & "c " & LOWER ( bn ) & " — mostly higher " & MAXX ( g, [Value1] ) & " (+" & FORMAT ( MAXX ( g, [Value2] ) * 100, "0.0" ) & "c)" )
		displayFolder: 10 Titles\Products
		lineageTag: 0059ad45-abfa-4c3a-bc79-8787b2aebed6

	measure 'Title Drill Campaign' =
			VAR c = SELECTEDVALUE ( DimCampaign[Campaign] )
			VAR t = SELECTEDVALUE ( DimCampaign[Campaign Type] )
			VAR nm = COALESCE ( c, IF ( NOT ISBLANK ( t ), t & " (all years)" ), "All campaigns and regular trading" )
			VAR n = [Net Sales]
			RETURN nm & ": " & IF ( n >= 1000000, FORMAT ( n / 1000000, "\€#,0.00\M" ), FORMAT ( n / 1000, "\€#,0.0\k" ) ) & " net sales, " & FORMAT ( [Contribution Margin %], "0.0%;−0.0%" ) & " margin at " & FORMAT ( [Weighted Discount %], "0.0%" ) & " average discount"
		displayFolder: 10 Titles\Drillthrough
		lineageTag: bef2475a-c1e9-484f-abf4-173d99250703

	measure 'Drill Campaign Facts' =
			VAR o = SELECTEDVALUE ( DimCampaign[Objective] )
			VAR nEvents = CALCULATE ( DISTINCTCOUNT ( DimCampaign[CampaignKey] ), DimCampaign[IsCampaign] = 1 )
			VAR budget = SUMX ( FILTER ( VALUES ( DimCampaign[CampaignKey] ), NOT ISBLANK ( [Net Sales] ) ), CALCULATE ( MAX ( DimCampaign[ActualCampaignSpendEUR] ) ) )
			VAR s = SELECTEDVALUE ( DimCampaign[Start Date] )
			VAR e = SELECTEDVALUE ( DimCampaign[End Date] )
			VAR d = SELECTEDVALUE ( DimCampaign[Duration Days] )
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( o ), "Several campaign types selected · " & nEvents & " events · combined budget " & FORMAT ( budget / 1000, "\€#,0.0\k" ),
			        o = "Regular trading", "Regular (non-campaign) trading · no event budget",
			        NOT ISBLANK ( s ), "Objective: " & o & " · " & FORMAT ( s, "d mmm" ) & " – " & FORMAT ( e, "d mmm yyyy" ) & " (" & d & " days) · event budget " & FORMAT ( budget / 1000, "\€#,0.0\k" ),
			        "Objective: " & o & " · " & nEvents & " events across the seasons · combined budget " & FORMAT ( budget / 1000, "\€#,0.0\k" ) )
		displayFolder: 10 Titles\Drillthrough
		lineageTag: cffe48e7-f331-4576-9b17-055a028dd41f

	measure 'Selection Summary' =
			VAR s = IF ( ISFILTERED ( DimDate[Season] ), CONCATENATEX ( VALUES ( DimDate[Season] ), DimDate[Season], ", " ), "All seasons" )
			VAR c = IF ( ISFILTERED ( FactSales[Sales Channel] ), CONCATENATEX ( VALUES ( FactSales[Sales Channel] ), FactSales[Sales Channel], ", " ), "All channels" )
			VAR g = IF ( ISFILTERED ( FactSales[Customer Segment] ), CONCATENATEX ( VALUES ( FactSales[Customer Segment] ), FactSales[Customer Segment], ", " ), "All segments" )
			VAR m = IF ( ISFILTERED ( DimLocation[City] ), CONCATENATEX ( VALUES ( DimLocation[City] ), DimLocation[City], ", " ), "All markets" )
			VAR p = IF ( ISFILTERED ( DimProduct[Category] ), CONCATENATEX ( VALUES ( DimProduct[Category] ), DimProduct[Category], ", " ), "All categories" )
			RETURN s & "  ·  " & c & "  ·  " & g & "  ·  " & m & "  ·  " & p
		displayFolder: 10 Titles
		lineageTag: 50df0de1-fee6-441b-ad69-a8b7b4fb1d29

	measure 'Colour Margin' =
			VAR m = [Contribution Margin %]
			RETURN SWITCH ( TRUE (), ISBLANK ( m ), BLANK (), m < 0, "#EF8354", m < 0.10, "#F4A37F", m < 0.25, "#7B89A0", "#4F5D75" )
