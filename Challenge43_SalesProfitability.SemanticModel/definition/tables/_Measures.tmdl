	measure 'Msg Ch4' = VAR t = [Pot Total k] RETURN IF ( ISBLANK ( t ) || t = 0, "No quantified upside in this selection", "Four moves are worth up to " & FORMAT ( t, "\€#,0.0\k" ) & " of contribution a season (" & FORMAT ( DIVIDE ( t * 1000, [Contribution AC] ), "+0%" ) & " on CY) if volumes hold" )
		displayFolder: 15 Redesign\Story\Messages
		lineageTag: bc25cda1-82e5-4c91-a7cf-33a2f9bd4bc1

	measure 'Title Bridge Var' = VAR t = ADDCOLUMNS ( FILTER ( ALL ( 'Bridge Lines' ), 'Bridge Lines'[Kind] = "Delta" ), "@i", [Bridge Impact k] ) VAR up = TOPN ( 1, t, [@i], DESC ) VAR dn = TOPN ( 1, t, [@i], ASC ) RETURN IF ( ISBLANK ( [Contribution PY] ), "No previous season to bridge from", "Biggest lift: " & LOWER ( MAXX ( up, 'Bridge Lines'[Label] ) ) & " (" & FORMAT ( MAXX ( up, [@i] ), "+\€#,0.0\k;−\€#,0.0\k" ) & ")" & IF ( MAXX ( dn, [@i] ) < 0, "; biggest drag: " & LOWER ( MAXX ( dn, 'Bridge Lines'[Label] ) ) & " (" & FORMAT ( MAXX ( dn, [@i] ), "+\€#,0.0\k;−\€#,0.0\k" ) & ")", "" ) )
