	measure 'Title Month AC' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( DimDate[Season Month] ), "@a", [Contribution AC], "@d", [Contribution ΔPY] ), NOT ISBLANK ( [@a] ) )
			VAR best = TOPN ( 1, t, [@a], DESC )
			VAR td = FILTER ( t, NOT ISBLANK ( [@d] ) )
			VAR up = TOPN ( 1, td, [@d], DESC )
			RETURN
			    IF ( COUNTROWS ( t ) = 0, "No sales in this selection",
			        MAXX ( best, DimDate[Season Month] ) & " earns the most contribution (" & FORMAT ( MAXX ( best, [@a] ) / 1000, "\€#,0.0\k" ) & ")"
			        & IF ( COUNTROWS ( td ) = 0, "", "; " & MAXX ( up, DimDate[Season Month] ) & " gained the most vs PY (" & FORMAT ( MAXX ( up, [@d] ) / 1000, "+\€#,0.0\k;−\€#,0.0\k" ) & ")" ) )
		displayFolder: 15 Redesign
		lineageTag: c3636cd9-b25f-43c3-9953-b0949feea5b1

	measure 'Period Short' = "CY " & [AC Season] & IF ( ISBLANK ( [Net Sales PY] ), " (no PY available)", " vs PY " & [PY Season] )
