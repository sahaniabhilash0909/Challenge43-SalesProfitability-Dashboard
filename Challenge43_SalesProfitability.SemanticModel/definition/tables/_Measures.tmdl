	measure 'TT Header' =
			SWITCH ( TRUE (),
			    ISFILTERED ( DimProduct[Product] ) && HASONEVALUE ( DimProduct[Product] ), VALUES ( DimProduct[Product] ),
			    ISFILTERED ( DimCampaign[Campaign] ) && HASONEVALUE ( DimCampaign[Campaign] ), VALUES ( DimCampaign[Campaign] ),
			    ISFILTERED ( DimLocation[City] ) && HASONEVALUE ( DimLocation[City] ), VALUES ( DimLocation[City] ),
			    ISFILTERED ( DimProduct[Subcategory] ) && HASONEVALUE ( DimProduct[Subcategory] ), VALUES ( DimProduct[Subcategory] ),
			    ISFILTERED ( DimProduct[Category] ) && HASONEVALUE ( DimProduct[Category] ), VALUES ( DimProduct[Category] ),
			    ISFILTERED ( DimCampaign[Campaign Type] ) && HASONEVALUE ( DimCampaign[Campaign Type] ), VALUES ( DimCampaign[Campaign Type] ),
			    ISFILTERED ( FactSales[Customer Segment] ) && HASONEVALUE ( FactSales[Customer Segment] ), VALUES ( FactSales[Customer Segment] ),
			    ISFILTERED ( FactSales[Sales Channel] ) && HASONEVALUE ( FactSales[Sales Channel] ), VALUES ( FactSales[Sales Channel] ),
			    ISFILTERED ( FactSales[Discount Band] ) && HASONEVALUE ( FactSales[Discount Band] ), "Discount " & VALUES ( FactSales[Discount Band] ),
			    ISFILTERED ( DimDate[Date] ) && HASONEVALUE ( DimDate[Date] ), FORMAT ( VALUES ( DimDate[Date] ), "ddd d mmm yyyy" ),
			    "Current selection" )
		displayFolder: 12 Tooltip
		lineageTag: 4f815af3-886d-4151-8b9a-92301b55a978

