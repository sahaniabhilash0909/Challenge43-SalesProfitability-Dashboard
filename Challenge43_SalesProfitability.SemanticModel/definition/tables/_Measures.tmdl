		lineageTag: da742eab-315b-440f-bd63-d63ce1278321

	measure 'Colour Δ Contribution' = VAR d = [Contribution ΔPY] RETURN IF ( ISBLANK ( d ), "#B5BECC", IF ( d >= 0, "#4F5D75", "#EF8354" ) )
