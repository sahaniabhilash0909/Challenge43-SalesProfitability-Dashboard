	measure 'Month Contrib Max AC k' =
			VAR v = [Contribution AC k]
			VAR mx =
			    IF (
			        ISINSCOPE ( DimDate[Date] ),
			        MAXX ( ALLSELECTED ( DimDate[Date] ), [Contribution AC k] ),
			        MAXX ( ALLSELECTED ( DimDate[Season Month], DimDate[SeasonMonthSort] ), [Contribution AC k] )
			    )
			RETURN IF ( NOT ISBLANK ( v ) && v = mx, v )
		formatString: \€#,0.0\k;−\€#,0.0\k;\€0.0\k
		displayFolder: 16 V8\Monthly
		lineageTag: b0817bec-be01-4af7-98dd-1b75cbb622e1

	measure 'Month Contrib Min AC k' =
			VAR v = [Contribution AC k]
			VAR mn =
			    IF (
			        ISINSCOPE ( DimDate[Date] ),
			        MINX ( ALLSELECTED ( DimDate[Date] ), [Contribution AC k] ),
			        MINX ( ALLSELECTED ( DimDate[Season Month], DimDate[SeasonMonthSort] ), [Contribution AC k] )
			    )
			RETURN IF ( NOT ISBLANK ( v ) && v = mn, v )
		formatString: \€#,0.0\k;−\€#,0.0\k;\€0.0\k
		displayFolder: 16 V8\Monthly
