	measure 'Bridge Raw' = SWITCH ( SELECTEDVALUE ( 'Bridge Lines'[Line] ), "Gross Sales", [Gross Sales], "Discounts", [Discount Amount], "Refunds", [Refunds], "Net COGS", [Net COGS], "Fulfilment", [Fulfilment Cost], "Payment Fees", [Payment Fees], "Return Handling", [Return Handling Cost], "Campaign Spend", [Campaign Spend] )
