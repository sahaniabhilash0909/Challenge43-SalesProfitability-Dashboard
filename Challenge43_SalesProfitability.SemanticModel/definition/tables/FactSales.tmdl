	/// Short discount band label (percent) for compact visuals.
	column Band = SWITCH ( FactSales[Discount Band], "No discount", "0", "40%+", "40+", SUBSTITUTE ( FactSales[Discount Band], "%", "" ) )
		dataType: string
		lineageTag: 39263570-dd4c-47c1-ba2e-2965b4f9e28c
		sortByColumn: DiscountBandSort

	partition FactSales = m
		mode: import
		source =
				let
				    Src = Excel.Workbook(File.Contents(DataFile), null, true),
				    Data = Src{[Item="FactSales",Kind="Sheet"]}[Data],
				    Prom = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Prom, {{"SaleLineKey", Int64.Type}, {"OrderID", type text}, {"SaleDate", type date}, {"ProductKey", Int64.Type}, {"CampaignKey", Int64.Type}, {"LocationKey", Int64.Type}, {"SalesChannel", type text}, {"CustomerSegment", type text}, {"UnitsSold", Int64.Type}, {"UnitListPriceEUR", Currency.Type}, {"DiscountRate", type number}, {"ReturnedUnits", Int64.Type}, {"UnitCostEUR", Currency.Type}, {"RecoveredCOGSEUR", Currency.Type}, {"FulfilmentCostEUR", Currency.Type}, {"PaymentFeesEUR", Currency.Type}, {"ReturnHandlingCostEUR", Currency.Type}, {"AllocatedCampaignSpendEUR", Currency.Type}, {"DiscountBand", type text}, {"DiscountBandSort", Int64.Type}, {"GrossSalesEUR", Currency.Type}, {"DiscountAmountEUR", Currency.Type}, {"SalesAfterDiscountEUR", Currency.Type}, {"RefundsEUR", Currency.Type}, {"NetSalesEUR", Currency.Type}, {"GrossCOGSEUR", Currency.Type}, {"NetCOGSEUR", Currency.Type}, {"GrossProfitEUR", Currency.Type}, {"ContributionProfitEUR", Currency.Type}, {"NetUnits", Int64.Type}}),
				    Seg = Table.AddColumn(Typed, "SegmentSort", each if [CustomerSegment] = "Loyal members" then 1 else if [CustomerSegment] = "Premium shoppers" then 2 else if [CustomerSegment] = "Occasional buyers" then 3 else 4, Int64.Type)
				in
				    Seg

