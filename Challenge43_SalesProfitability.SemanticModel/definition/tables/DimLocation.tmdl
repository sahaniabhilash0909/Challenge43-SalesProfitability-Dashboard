	partition DimLocation = m
		mode: import
		source =
				let
				    Src = Excel.Workbook(File.Contents(DataFile), null, true),
				    Data = Src{[Item="DimLocation",Kind="Sheet"]}[Data],
				    Prom = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Prom, {{"LocationKey", Int64.Type}, {"Region", type text}, {"Country", type text}, {"City", type text}, {"Latitude", type number}, {"Longitude", type number}, {"LocationType", type text}, {"CoordinateSource", type text}})
				in
