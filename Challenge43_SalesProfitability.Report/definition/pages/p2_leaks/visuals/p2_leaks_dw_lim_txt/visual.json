                      "fontSize": "5pt",
                      "color": "#2D3142"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Contribution profit",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold'",
                      "fontSize": "9.5pt",
                      "color": "#2D3142",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " = net sales \u2212 product cost \u2212 fulfilment \u2212 payment fees \u2212 return handling \u2212 allocated campaign spend. It excludes overhead, interest and tax.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#454A5E"
                    }
