              {
                "textRuns": [
                  {
                    "value": "Synthetic data.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold'",
                      "fontSize": "9.5pt",
                      "color": "#2D3142",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " Three October\u2013January holiday windows (2023/24, 2024/25, 2025/26) across eight European city markets. 2023/24 has no PY.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#454A5E"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
