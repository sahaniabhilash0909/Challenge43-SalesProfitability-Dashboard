                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#2D3142"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Descriptive, not causal.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold'",
                      "fontSize": "9.5pt",
                      "color": "#2D3142",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " There is no control group, randomisation or ad-exposure data, so nothing here proves a campaign caused extra sales, uplift or ROI.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#454A5E"
                    }
