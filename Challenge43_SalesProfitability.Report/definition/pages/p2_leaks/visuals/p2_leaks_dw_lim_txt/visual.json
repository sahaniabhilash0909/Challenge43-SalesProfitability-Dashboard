                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#2D3142"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Unequal durations.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold'",
                      "fontSize": "9.5pt",
                      "color": "#2D3142",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " Black Friday and Cyber Monday run 3 days; Christmas 17 and New Year 15. Compare margins or per-day sales, not totals.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#454A5E"
                    }
